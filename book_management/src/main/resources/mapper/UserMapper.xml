<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.txf.book_management.dao.UserMapper">
    <resultMap id="UserBaseMap" type="org.txf.book_management.model.User">
        <id column="id" property="id"></id>
        <result column="user_name" property="userName" ></result>
        <result column="password" property="password" ></result>
        <result column="delete_flag" property="deleteFlag" ></result>
        <result column="create_time" property="createTime" ></result>
        <result column="update_time" property="updateTime" ></result>
    </resultMap>
<!--    这里手动做一个映射，可以在mybatis设置自动映射-->
    <select id = "getUserByUsnAndPwd" resultMap="UserBaseMap">
        select `id`, `user_name`, `password`, `delete_flag`, `create_time`, `update_time`
        from user_info
        where user_name = #{username}
        and password = #{password}
    </select>
</mapper>