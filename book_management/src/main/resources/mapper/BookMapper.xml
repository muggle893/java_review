<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.txf.book_management.dao.BookMapper">
    <sql id = "bookAttrs">
        `id`, `book_name`,
               `author`, `count`, `price`,
               `publish`, `status`, `create_time`,
               `update_time`
    </sql>

    <select id = "selectAll" resultType="org.txf.book_management.model.Book">
        select <include refid="bookAttrs"></include>
        from book_info;
    </select>

    <select id = "selectByPage" resultType="org.txf.book_management.model.Book">
        select <include refid="bookAttrs"></include>
        from book_info
        order by id asc
        LIMIT #{limit} OFFSET #{offset};
    </select>

    <select id="getBookCount" resultType="java.lang.Long">
        select count(*) from book_info;
    </select>

    <sql id = "tableField">
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bookName != null">book_name,</if>
            <if test="author != null">author,</if>
            <if test="count != null">`count`,</if>
            <if test="price != null">price,</if>
            <if test="publish != null">publish,</if>
            <if test="status != null">status,</if>
        </trim>
    </sql>
    <sql id = "fieldValues">
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bookName != null">#{bookName},</if>
            <if test="author != null">#{author},</if>
            <if test="count != null">#{count},</if>
            <if test="price != null">#{price},</if>
            <if test="publish != null">#{publish},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </sql>

    <insert id = "addBook" parameterType="org.txf.book_management.model.Book">
        insert into book_info <include refid="tableField"></include>
        values <include refid="fieldValues"></include>;
    </insert>

    <update id = "updateBook">
        update book_info
        <set >
            <if test="bookName != null">book_name = #{bookName},</if>
            <if test="author != null">author = #{author},</if>
            <if test="count != null">`count` = #{count},</if>
            <if test="price != null">price = #{price},</if>
            <if test="publish != null">publish = #{publish},</if>
            <if test="status != null">status = #{status}</if>
        </set>
        <where>
            id = #{id}
        </where>
    </update>

    <select id = "getBookById">
        select <include refid="bookAttrs"></include>
        from book_info
        where id = #{id}
    </select>
</mapper>